<IfModule mod_rewrite.c>
    RewriteEngine On

    # Izinkan verifikasi SSL (.well-known)
    RewriteCond %{REQUEST_URI} ^/\.well-known/
    RewriteRule ^ - [L]

    # Blokir akses langsung ke file sensitif (.env, .git, dll)
    RewriteRule ^\. - [F,L]

    # Arahkan seluruh request ke folder public Laravel
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
